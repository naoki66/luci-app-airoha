#!/usr/bin/ucode
// SPDX-License-Identifier: Apache-2.0
'use strict';

/*
 * clients-probe - data source for the LuCI "Clients" page.
 *
 * Merges three views of the same population (LAN hosts) into one document keyed
 * by MAC:
 *
 *   addresses   ARP + IPv6 neighbour cache          who is reachable now
 *   rates       nf_conntrack byte counters          how much traffic, coarse
 *   wifi        iwinfo assoclist                    which AP/SSID, signal
 *   wifi_radios how many radios network.wireless has  has-WiFi flag
 *
 * No arguments prints a live snapshot and exits:
 *
 *   {
 *     "ts": 1792939457,
 *     "interfaces": [ { "iface": "lan2", "device": "br-lan.2", "vlan": 2,
 *                       "subnets": [ "10.10.20.0/24" ] } ],
 *     "arp":    [ { "ip": "10.10.20.93", "mac": "8E:5F:E7:18:85:E3",
 *                   "device": "br-lan.2" } ],
 *     "neigh6": [ { "ip": "2408:...", "mac": "58:CD:C9:C6:40:91",
 *                   "state": "STALE", "device": "br-lan.2" } ],
 *     "wifi":   { "8E:5F:E7:18:85:E3": { "ssid": "OPLT_5G", "ifname": "phy0.1-ap1",
 *                   "band": "5G", "signal": -35, "noise": -89 } },
 *     "traffic": { "10.10.20.93": { "up": 15744, "down": 2776, "conns": 2,
 *                   "device": "br-lan.2" } },
 *     "stats": { "conntrack": 860, "conntrack_max": 16384 },
 *     "bridge": { "mode": true, "uplink": "wan",
 *                 "members": [ "wan", "lan2" ],
 *                 "ports": { "wan": { "rx": 4926429178, "tx": 4101720363 },
 *                            "lan2": { "rx": 7101134, "tx": 13992952 } } },
 *     "nlbw_used": false,
 *     "snoop4": [ { "mac": "8E:5F:E7:18:85:E3", "ip": "10.10.20.93" } ],
 *     "snoop6": [ { "mac": "E8:68:B1:36:F4:75", "ip": "2408:...", "fresh": true } ]
 *   }
 *
 * `nlbw_used` is true when at least one host's traffic had to be taken from
 * nlbwmon because hardware flow offload had zeroed its conntrack byte counters.
 * nlbwmon reads the same driver accounting conntrack does, so the figures stay
 * correct for offloaded flows; on a box without it (or without offload) the
 * conntrack bytes are used unchanged and the flag stays false.
 *
 * `names` maps MAC -> hostname from the lease file, the luci-rpc hints and
 * the DHCP Host-Name option heard on the bridge, in that priority. On a
 * routed box one final PTR pass asks the local dnsmasq when the page is
 * being watched (the background collector passes it by); a bridging device
 * (AP mode) never queries anything.
 *
 * Subcommands:
 *
 *   clients-probe collect [history] [retention] [every] [snapshot] [max_bytes]
 *                          sample, refresh the live cache, merge into history
 *   clients-probe read     print the history file
 *   clients-probe clear    empty the history file
 *   clients-probe status   file sizes, history summary, last inner-LAN figure
 *   clients-probe intra-setup  (re)create the bridge counter for inner-LAN traffic
 *   clients-probe intra    print that counter as it stands
 *
 * `intra` in the snapshot is the traffic between two clients of the same
 * subnet, which only a counter in the kernel's bridge family can see: the
 * frames are switched, never routed, so conntrack never learns about them.
 * It is one figure without a direction, and unavailable (`ok: false`) on a
 * device without a bridge or without nft.
 *
 * The history is what makes the page more than a live view: first and last seen
 * survive a station going away, and the wireless association (SSID, band,
 * signal) survives a client roaming off this AP. It is written to /tmp on
 * purpose - a status page must not wear the flash - so it resets on reboot. The
 * page says so instead of pretending otherwise.
 *
 * The sampling clock belongs to the collector, not to the browser. `collect`
 * writes the snapshot it just built to /tmp/clients-snapshot.json with the
 * cumulative counters already differentiated against the previous pass: `rates`
 * and `totals` per address, `rates` and `totals` per bridge port, plus
 * `rate_window`, the length of the interval they were divided by (0 when there
 * was no usable baseline). It also appends one `trend` point per pass - the
 * summed LAN/WAN rates, and the per-device series for the busiest few MACs - so
 * the chart has history before anyone opens the page instead of starting to
 * fill in from the moment it is looked at. Opening the page then reads one
 * file: no conntrack walk per viewer, and two tabs cost exactly as much as one. `every` decouples
 * the archive merge from that cadence: the live file is rewritten on every
 * pass, the history only when it is due, and the stamp that decides it is kept
 * in the live file so the loop carries no state of its own.
 *
 * The snapshot is a slow document by construction - it answers "who is on my
 * network", which needs ARP, iw, nlbwmon and nft on top of the conntrack walk.
 * Measured on target a pass costs 0.8 s, so with the configured 10 s sleep the
 * file is rewritten every 10.8 s, and anything reading it inherits that as its
 * refresh rate. The tiles only need four numbers out of it, so `tick` runs the
 * cheap half on its own clock (2 s) and writes a short ring of samples to
 * /tmp/clients-samples.json: conntrack for the scopes, the port counters on a
 * bridging device, the intra counter, and nothing else. Two files, two writers
 * - sharing one would put two renames in a race where the loser is a whole
 * collection pass. The page consumes the ring by timestamp, so a poll that
 * lands late still gets every sample it missed.
 *
 * Every file written here is capped in bytes, not merely in rows: /tmp is RAM,
 * and a cache whose shape grows with the number of addresses seen would
 * eventually eat it. A document over `max_bytes` gives up its least interesting
 * rows until it fits, so a pathological network costs one bounded file per
 * cache instead of the box.
 *
 * Two design notes carried over from the ONU host list, both learned on target:
 *
 * 1. conntrack accounting keeps counting even for PPE-offloaded flows - the
 *    driver syncs the counters back. That is why the coarse path is still
 *    worth keeping on a PON gateway, where turning the offload off to get
 *    exact per-device rates would cost more than the measurement is worth.
 *
 * 2. Only resolved ARP entries are hosts. An incomplete entry keeps a zero MAC
 *    and would list every probe for a dead address as a client.
 */

let fs = require('fs');
import { connect } from 'ubus';

const ARP_FILE = '/proc/net/arp';
const LEASE_FILE = '/tmp/dhcp.leases';
const CONNTRACK_FILE = '/proc/net/nf_conntrack';
const CONNTRACK_COUNT = '/proc/sys/net/netfilter/nf_conntrack_count';
const CONNTRACK_MAX = '/proc/sys/net/netfilter/nf_conntrack_max';

const DEFAULT_HISTORY = '/tmp/clients-history.json';
const DEFAULT_SNAPSHOT = '/tmp/clients-snapshot.json';
const DEFAULT_SAMPLES = '/tmp/clients-samples.json';
const SNOOP_FILE = '/tmp/clients-snoop.json';

/* Every writer is capped in bytes, not only in rows. /tmp is RAM, so the worst
 * case has to be a constant that was chosen, not a function of how many
 * addresses a network happened to hand out: 256 KiB per file is several times
 * what a /24 of real clients needs and a rounding error in the memory of any
 * box that can run this page. */
const DEFAULT_MAX_BYTES = 262144;

/* Rows kept in the live snapshot. The kernel's own conntrack table is smaller
 * than this on every device that runs the page; the bound exists so that a
 * stale row cannot outlive the flow that created it. */
const MAX_TRAFFIC_ROWS = 1024;

/* Points kept in the trend series - the widest window the page offers is 25
 * minutes, so at the default 10 s cadence 180 points cover it with margin. */
const TREND_POINTS = 180;

/* Points kept in the fast ring. At the 1 s tick the page runs this is three
 * minutes, which covers the shortest window the chart offers (five) with room
 * for a late tick, at a granularity the 10 s trend cannot express. */
const SAMPLE_POINTS = 180;

/* Width of the moving window the tick reports over. The counters behind it are
 * reconciled in bursts of a few seconds, so a single tick is too thin a
 * baseline to divide by - see the note in tick() for the measurement. Kept
 * short because the window is also the lag the tile shows: three seconds is
 * enough to span a batch boundary without the number trailing the network. */
const SAMPLE_SPAN = 3;

/* Devices that can be the WAN side when no bridge contains it. A router's
 * uplink is routed, so it is not a brif member and has to be named; PPPoE
 * first because that is the shape on this fleet, then the plain names. */
const WAN_CANDIDATES = [ 'pppoe-wan', 'wan', 'wwan', 'wwan0', 'usb0' ];

/* Stations kept in the per-MAC rate table. A pathological neighbour table
 * should not turn the ring into a large file; the busiest are not ranked
 * because nlbwmon already answers for the whole box in one call and dropping
 * the tail is cheaper than sorting every five seconds. */
const SAMPLE_HOSTS = 256;

/* A rate is only meaningful across a short window. If the collector was
 * stopped, suspended or simply ran late, the counters moved but the interval
 * is unknown - dividing by it would invent a rate, so the baseline is dropped
 * and the pass after it starts a new one. */
const RATE_MAX_GAP = 60;

/* A passive observation this fresh counts as the host speaking right now.
 * Older observations keep attributing the address but stop marking the row
 * online - a duplicate-address probe from an hour ago is history, not
 * presence. */
const SNOOP_FRESH = 120;

/* ---------------- small helpers ---------------- */

function run(cmd) {
	let handle = fs.popen(cmd);
	let out;

	if (!handle)
		return '';

	try {
		out = handle.read('all');
	}
	catch (e) {
		out = null;
	}

	handle.close();

	return out ?? '';
}

function read(path) {
	let data;

	try {
		data = fs.readfile(path);
	}
	catch (e) {
		return '';
	}

	return data ?? '';
}

/* ucode answers 0 for `int(null)` and NaN for a non-numeric string, so a
 * missing argument never falls through `?? fallback` - it just becomes zero.
 * Every numeric argument is read through here instead. */
function number_arg(value, fallback) {
	if (value == null || length(value) == 0)
		return fallback;

	let n = int(value);

	return (n == null || n != n) ? fallback : n;
}

function is_hex(text, maxlen) {
	let len = length(text);

	if (len < 1 || len > maxlen)
		return false;

	for (let i = 0; i < len; i++) {
		let code = ord(text, i);

		if ((code < 48 || code > 57) && (code < 97 || code > 102))
			return false;
	}

	return true;
}

/* ---------------- address arithmetic ---------------- */

/*
 * Dotted-quad to integer in one pass. Splitting on '.' allocates an array of
 * four strings per address and this runs twice per conntrack entry; scanning the
 * characters directly costs one string walk and no allocation.
 */
function parse_v4(text) {
	let len = length(text ?? ''), value = 0, part = 0, digits = 0, parts = 0;

	for (let i = 0; i < len; i++) {
		let code = ord(text, i);

		if (code == 46) {
			if (digits == 0 || digits > 3 || part > 255)
				return null;

			value = value * 256 + part;
			part = 0;
			digits = 0;
			parts++;
			continue;
		}

		if (code < 48 || code > 57)
			return null;

		part = part * 10 + (code - 48);
		digits++;
	}

	if (parts != 3 || digits == 0 || digits > 3 || part > 255)
		return null;

	return value * 256 + part;
}

function format_v4(value) {
	return sprintf('%d.%d.%d.%d',
		int(value / 16777216) % 256,
		int(value / 65536) % 256,
		int(value / 256) % 256,
		value % 256);
}

function parse_v6(text) {
	let head, tail, words = [], filled, groups;

	text = lc(text ?? '');

	if (index(text, '.') >= 0) {
		/* Mixed form: only the trailing IPv4 part needs folding. */
		let cut = rindex(text, ':');
		let v4 = parse_v4(substr(text, cut + 1));

		if (v4 == null)
			return null;

		text = substr(text, 0, cut + 1)
			+ sprintf('%x:%x', int(v4 / 65536), v4 % 65536);
	}

	groups = split(text, '::');

	if (length(groups) > 2)
		return null;

	if (length(groups) == 1) {
		head = split(groups[0], ':');

		if (length(head) != 8)
			return null;

		tail = [];
		filled = 0;
	}
	else {
		head = (groups[0] == '') ? [] : split(groups[0], ':');
		tail = (groups[1] == '') ? [] : split(groups[1], ':');
		filled = 8 - length(head) - length(tail);

		if (filled < 0)
			return null;
	}

	for (let group in head) {
		if (!is_hex(group, 4))
			return null;

		push(words, hex(group));
	}

	for (let i = 0; i < filled; i++)
		push(words, 0);

	for (let group in tail) {
		if (!is_hex(group, 4))
			return null;

		push(words, hex(group));
	}

	return (length(words) == 8) ? words : null;
}

function format_v6(words) {
	let groups = [];

	for (let word in words)
		push(groups, sprintf('%x', word));

	return join(':', groups);
}

function subnet_v4(addr, mask) {
	let base = parse_v4(addr);

	if (base == null)
		return null;

	mask = (mask == null) ? 24 : int(mask);

	if (mask < 0 || mask > 32)
		return null;

	let size = (mask == 32) ? 1 : (1 << (32 - mask));
	let low = base - (base % size);

	/* A v4 subnet is a closed integer range; the conntrack loop only compares. */
	return {
		family: 4,
		lo: low,
		hi: low + size - 1,
		text: sprintf('%s/%d', format_v4(low), mask)
	};
}

function subnet_v6(addr, mask) {
	let words = parse_v6(addr);

	if (words == null)
		return null;

	mask = (mask == null) ? 64 : int(mask);

	if (mask < 0 || mask > 128)
		return null;

	for (let i = 0; i < 8; i++) {
		let bits = mask - i * 16;

		if (bits >= 16)
			continue;

		if (bits <= 0) {
			words[i] = 0;
			continue;
		}

		/* Keep the top `bits` bits of the word. */
		words[i] = words[i] & ((65535 << (16 - bits)) & 65535);
	}

	return {
		family: 6,
		words: words,
		mask: mask,
		text: sprintf('%s/%d', format_v6(words), mask)
	};
}

function in_subnet_v6(subnet, words) {
	for (let i = 0; i < 8; i++) {
		let bits = subnet.mask - i * 16;

		if (bits >= 16) {
			if (words[i] != subnet.words[i])
				return false;

			continue;
		}

		if (bits <= 0)
			return true;

		let keep = (65535 << (16 - bits)) & 65535;

		return (words[i] & keep) == subnet.words[i];
	}

	return true;
}

/* ---------------- LAN discovery ---------------- */

/*
 * Every interface named "lan" or "lanN" is a client-facing network. On a
 * multi-VLAN AP (six bridged VLANs is a real deployment here) that is six
 * networks with six subnets behind a single page, and the table needs to say
 * which one a client sits on - hence `vlan` in the output.
 *
 * The VLAN id comes from the device suffix (br-lan.3 -> 3) because that is what
 * the bridge is actually configured with; the interface name is only a fallback
 * for a deployment that names its bridges differently.
 */
function vlan_of(device, iface) {
	let m = match(device ?? '', /^[a-z0-9_-]+\.([0-9]+)$/);

	if (m)
		return int(m[1]);

	m = match(iface ?? '', /^lan([0-9]+)$/);

	if (m)
		return int(m[1]);

	return 0;
}

function lan_state() {
	let interfaces = [], local = [];
	let ubus = connect();

	if (!ubus)
		return { interfaces: interfaces, local: local };

	let dump = null;

	try {
		dump = ubus.call('network.interface', 'dump');
	}
	catch (e) {
		dump = null;
	}

	ubus.disconnect();

	for (let iface in (dump && dump.interface) ? dump.interface : []) {
		let name = iface.interface ?? '';

		/* "lan" and its numbered aliases only. The service bridges (br-iptv,
		 * ct-voice) and the WAN are excluded on purpose: this page answers
		 * "who is on my network", not "what did the router route". */
		if (name != 'lan' && !match(name, /^lan[0-9]+$/))
			continue;

		let device = iface.l3_device || iface.device;

		if (!device)
			continue;

		let subnets = [];

		for (let address in (iface['ipv4-address'] ?? [])) {
			let subnet = subnet_v4(address.address, address.mask);

			if (subnet)
				push(subnets, subnet);

			push(local, address.address);
		}

		for (let address in (iface['ipv6-address'] ?? [])) {
			push(local, address.address);

			/* A /128 host address says nothing about the prefix clients use. */
			if (address.mask == null || int(address.mask) >= 128)
				continue;

			let subnet = subnet_v6(address.address, address.mask);

			if (subnet)
				push(subnets, subnet);
		}

		push(interfaces, {
			iface: name,
			device: device,
			vlan: vlan_of(device, name),
			subnets: subnets
		});
	}

	return { interfaces: interfaces, local: local };
}

function device_names(interfaces) {
	let devices = [];

	for (let entry in interfaces)
		if (index(devices, entry.device) < 0)
			push(devices, entry.device);

	return devices;
}

function all_subnets(interfaces) {
	let subnets = [];

	for (let entry in interfaces)
		for (let subnet in entry.subnets)
			push(subnets, subnet);

	return subnets;
}

/* ---------------- neighbours ---------------- */

function arp_entries(devices) {
	let entries = [];
	let lines = split(trim(read(ARP_FILE)), '\n');

	/* ip, HW type, flags, MAC, mask, device - /proc/net/arp is stable. */
	for (let i = 1; i < length(lines); i++) {
		let fields = split(trim(lines[i]), /[ \t]+/);

		if (length(fields) < 6)
			continue;

		let ip = fields[0], flags = fields[2], mac = lc(fields[3]), device = fields[5];

		if (index(devices, device) < 0)
			continue;
		if (parse_v4(ip) == null)
			continue;

		/* ATF_COM (0x2) is the only flag that means "resolved": incomplete
		 * entries keep a zero MAC and would list every gateway probe as a
		 * host. The multicast bit excludes bridge-group noise. */
		if (!((hex(flags) ?? 0) & 2))
			continue;
		if (!match(mac, /^[0-9a-f]{2}(:[0-9a-f]{2}){5}$/) || mac == '00:00:00:00:00:00')
			continue;
		if (hex(substr(mac, 0, 2)) % 2)
			continue;

		push(entries, { ip: ip, mac: uc(mac), device: device });
	}

	return entries;
}

/*
 * `ip -6 neigh show` is netlink-backed and prints one line per cache entry:
 *
 *   2408:8262:... dev br-lan lladdr 58:cd:c9:c6:40:91 STALE
 *    fe80::3a05:... dev br-lan FAILED
 *
 * Only entries that resolved to a link-layer address are hosts; FAILED and
 * INCOMPLETE rows are the other end of a failed probe and carry no lladdr.
 * Link-local addresses are skipped: they are per-interface, not per-host.
 */
function neighbour6(devices) {
	let entries = [];
	let lines = split(trim(run('ip -6 neigh show 2>/dev/null')), '\n');

	for (let line in lines) {
		let fields = split(trim(line), /[ \t]+/);
		let ip = fields[0], device = null, mac = null, state = '';

		if (ip == null || substr(ip, 0, 5) == 'fe80:')
			continue;

		for (let i = 1; i < length(fields); i++) {
			if (fields[i] == 'dev' && fields[i + 1] != null)
				device = fields[i + 1];
			else if (fields[i] == 'lladdr' && fields[i + 1] != null)
				/* Kept lower case until the shape check below: the pattern is
				 * written in one case, and the value is upper-cased after it so
				 * that both tables key clients the same way. */
				mac = lc(fields[i + 1]);
			else if (i + 1 == length(fields))
				state = fields[i];
		}

		if (device == null || mac == null || index(devices, device) < 0)
			continue;
		if (!match(mac, /^[0-9a-f]{2}(:[0-9a-f]{2}){5}$/))
			continue;

		push(entries, { ip: ip, mac: uc(mac), device: device, state: state });
	}

	return entries;
}

/* ---------------- DHCP leases ---------------- */

/*
 * dnsmasq's lease file is where a hostname survives after the client leaves:
 * the neighbour cache forgets it and the radio forgets it. The line format has
 * been stable for years:
 *
 *   1792940000 8e:5f:e7:18:85:e3 10.10.20.93 M2105K81C.lan 01:8e:5f:...
 *
 * A hostname of "*" means the client never sent one - a literal asterisk, not
 * an absence - so it is normalised to null here instead of leaking into a row.
 *
 * The file can be empty, and on this fleet often is: where DHCP is served
 * upstream (an AP behind a gateway) there is nothing to lease locally. The
 * second half of host_names() covers that case.
 */
function dhcp_leases() {
	let map = {};
	let lines = split(trim(read(LEASE_FILE)), '\n');

	for (let line in lines) {
		let fields = split(trim(line), /[ \t]+/);
		let mac = lc(fields[1] ?? '');
		let ip = fields[2] ?? '';
		let name = fields[3] ?? '';

		if (!match(mac, /^[0-9a-f]{2}(:[0-9a-f]{2}){5}$/))
			continue;

		if (name == '*' || name == '')
			name = null;

		map[uc(mac)] = { ip: ip, name: name };
	}

	return map;
}

/*
 * MAC -> hostname, from both places a name can come from. The lease file wins:
 * it is what this box actually handed out. luci-rpc's hints carry the rest -
 * names dnsmasq learned from DNS, from /etc/ethers, from the DHCP
 * configuration, or from a reverse lookup of a neighbour - and that object
 * exists on every image that runs this page, because the page itself needs it.
 *
 * Called as root from rpcd's exec path, so the ACL on the object does not apply
 * here; a failing rpcd simply costs the names, not the page.
 */
function host_names(leases) {
	let map = {};

	for (let mac in leases)
		if (leases[mac].name)
			map[mac] = leases[mac].name;

	let ubus = connect();

	if (!ubus)
		return map;

	let hints = null;

	try {
		hints = ubus.call('luci-rpc', 'getHostHints');
	}
	catch (e) {
		hints = null;
	}

	ubus.disconnect();

	/*
	 * Two shapes exist in the wild for this object: the raw rpcd answer is a
	 * flat map of MAC -> { ipaddrs, ip6addrs, name }, while LuCI's network
	 * module re-wraps it as { hosts: {...} }. Accept both rather than betting on
	 * one and silently losing every name on the other.
	 */
	let hosts = (hints && hints.hosts) ? hints.hosts : hints;

	if (hosts) {
		for (let mac in hosts) {
			let name = hosts[mac]?.name;

			if (name && map[uc(mac)] == null)
				map[uc(mac)] = name;
		}
	}

	return map;
}

/* ---------------- wireless association ---------------- */

/*
 * The AP knows something the ARP table never will: which radio a client is on,
 * under which SSID, and how strong the link is. On a multi-SSID box that is the
 * difference between "a host called android-1 is here" and "a phone is on the
 * 5 GHz guest network, -52 dBm".
 *
 * A client can appear on more than one VAP during a roam; the entry with the
 * strongest signal wins, because that is the one it is actually associated with.
 */
function band_of(freq) {
	let f = int(freq) ?? 0;

	if (f >= 5925 && f < 7125)
		return '6G';
	if (f >= 5150 && f < 5925)
		return '5G';
	if (f >= 2400 && f < 2500)
		return '2.4G';

	return null;
}

function wifi_state() {
	let map = {};
	let radios = 0;
	let ubus = connect();

	if (!ubus)
		return [ map, radios ];

	let status = null;

	try {
		status = ubus.call('network.wireless', 'status');
	}
	catch (e) {
		status = null;
	}

	if (!status) {
		ubus.disconnect();
		return [ map, radios ];
	}

	for (let radio in status) {
		let ifaces = status[radio]?.interfaces;

		if (!ifaces)
			continue;

		/* Counted before the per-interface work: a radio with an interface
		 * exists whether or not anyone associates, and "no radios" is what
		 * tells the devices page a Signal column can never mean anything. */
		radios++;

		for (let iface in ifaces) {
			let ifname = iface?.ifname;

			if (!ifname)
				continue;

			let info = null, assoc = null;

			try {
				info = ubus.call('iwinfo', 'info', { device: ifname });
				assoc = ubus.call('iwinfo', 'assoclist', { device: ifname });
			}
			catch (e) {
				continue;
			}

			if (!assoc?.results)
				continue;

			let ssid = info?.ssid ?? info?.essid ?? '';
			let band = band_of(info?.frequency) ?? iface?.config?.band ?? null;

			for (let bss in assoc.results) {
				let mac = bss?.mac;

				if (!mac)
					continue;

				let entry = {
					ssid: ssid,
					ifname: ifname,
					radio: radio,
					band: band,
					signal: int(bss?.signal) ?? 0,
					noise: int(bss?.noise) ?? 0
				};

				let key = uc(mac);
				let previous = map[key];

				if (previous && previous.signal >= entry.signal)
					continue;

				map[key] = entry;
			}
		}
	}

	ubus.disconnect();

	return [ map, radios ];
}

/* ---------------- conntrack accounting ---------------- */

/*
 * One nf_conntrack line holds the original tuple, then the reply tuple, as
 * `src= dst= ... bytes=` groups; both directions carry their own byte count, so
 * the classification below only has to find which side of the original tuple is
 * a LAN address.
 *
 * The scan walks key to key with index() and takes the token that follows it up
 * to the next space. Measured on target (665 entries, AN7581): 135 ms here
 * against 726 ms for the previous implementation, which stepped through the
 * line one character at a time - ord() costs 6-12 us per call on this box, and
 * an address token is a dozen of them. Splitting the whole line on spaces and
 * picking tokens out costs 299 ms, so walking to the three keys we need is
 * still the cheaper of the two, just not for the reason the old comment gave.
 */
function token_at(line, from) {
	let end = index(line, ' ', from);

	return (end < 0) ? substr(line, from) : substr(line, from, end - from);
}

function split_tuple(line) {
	let family;
	let head = substr(line, 0, 4);

	if (head == 'ipv4')
		family = 4;
	else if (head == 'ipv6')
		family = 6;
	else
		return null;

	let tuples = [], pos = 0;

	while (true) {
		let src_at = index(line, 'src=', pos);

		if (src_at < 0)
			break;

		let src = token_at(line, src_at + 4);
		let dst = null, bytes = 0, end = src_at + 4;

		let dst_at = index(line, 'dst=', end);

		if (dst_at >= 0) {
			dst = token_at(line, dst_at + 4);
			end = dst_at + 4;
		}

		let bytes_at = index(line, 'bytes=', end);

		if (bytes_at >= 0) {
			bytes = int(token_at(line, bytes_at + 6)) ?? 0;
			end = bytes_at + 6;
		}

		push(tuples, { src: src, dst: dst, bytes: bytes });

		/* Skip past this tuple's own counters so the next src= is the reply. */
		pos = end;
	}

	return { family: family, tuples: tuples };
}

function in_any_v4(list, value) {
	for (let subnet in list)
		if (value >= subnet.lo && value <= subnet.hi)
			return true;

	return false;
}

function in_any_v6(list, words) {
	for (let subnet in list)
		if (in_subnet_v6(subnet, words))
			return true;

	return false;
}

/*
 * One flow, counted both in the client's total and in the scope it belongs to.
 *
 * The split is decided by the far end of the flow, not by the interface: a
 * conntrack entry does not record which interface it used, but it does record
 * both addresses, and "the other end is another LAN address" is exactly what
 * separates a client talking to a NAS from a client talking to the internet.
 * This is why the page can show LAN and WAN columns without the eBPF sampler
 * that would have required turning the flow offload off.
 */
function account(hosts, ip, up, down, scope) {
	let entry = hosts[ip] ?? {
		up: 0, down: 0, conns: 0,
		lan: { up: 0, down: 0, conns: 0 },
		wan: { up: 0, down: 0, conns: 0 }
	};

	entry.up += up;
	entry.down += down;
	entry.conns += 1;
	entry[scope].up += up;
	entry[scope].down += down;
	entry[scope].conns += 1;
	hosts[ip] = entry;
}

/*
 * Addresses repeat heavily inside one conntrack dump - a few dozen distinct
 * addresses across several hundred flows - and parsing one of them costs around
 * 90 us on target, because ord() alone is 6-12 us per character. One memo per
 * dump turns the repeat into a hash lookup; the failure result is cached too,
 * so a malformed address is not re-parsed for every flow that carries it.
 */
function parse_v4_memo(text, memo) {
	if (text == null)
		return null;

	if (text in memo)
		return memo[text];

	let value = parse_v4(text);

	memo[text] = value;

	return value;
}

function parse_v6_memo(text, memo) {
	if (text == null)
		return null;

	if (text in memo)
		return memo[text];

	let value = parse_v6(text);

	memo[text] = value;

	return value;
}

function traffic(subnets, local) {
	let hosts = {};
	let v4 = [], v6 = [];
	let memo4 = {}, memo6 = {};

	for (let subnet in subnets) {
		if (subnet.family == 4)
			push(v4, subnet);
		else
			push(v6, subnet);
	}

	let lines = split(trim(read(CONNTRACK_FILE)), '\n');

	for (let line in lines) {
		let flow = split_tuple(line);

		if (flow == null || length(flow.tuples) == 0)
			continue;

		let orig = flow.tuples[0];
		let reply = flow.tuples[1];
		let reply_bytes = reply ? reply.bytes : 0;

		if (orig.src == null || orig.dst == null)
			continue;

		if (index(local, orig.src) >= 0 || index(local, orig.dst) >= 0)
			/* The router's own addresses are inside the LAN subnet but are not
			 * hosts: DNS, DHCP and the LuCI session would otherwise show up as
			 * a client with a large connection count. */
			continue;

		if (flow.family == 4) {
			let src = parse_v4_memo(orig.src, memo4);
			let dst = parse_v4_memo(orig.dst, memo4);

			if (src == null || dst == null)
				continue;

			let is_src = in_any_v4(v4, src);
			let is_dst = in_any_v4(v4, dst);

			if (is_src)
				account(hosts, orig.src, orig.bytes, reply_bytes,
					is_dst ? 'lan' : 'wan');
			else if (is_dst)
				account(hosts, orig.dst, reply_bytes, orig.bytes,
					is_src ? 'lan' : 'wan');
		}
		else {
			let src = parse_v6_memo(orig.src, memo6);
			let dst = parse_v6_memo(orig.dst, memo6);

			if (src == null || dst == null)
				continue;

			let is_src = in_any_v6(v6, src);
			let is_dst = in_any_v6(v6, dst);

			if (is_src)
				account(hosts, orig.src, orig.bytes, reply_bytes,
					is_dst ? 'lan' : 'wan');
			else if (is_dst)
				account(hosts, orig.dst, reply_bytes, orig.bytes,
					is_src ? 'lan' : 'wan');
		}
	}

	return hosts;
}

function conntrack_stats() {
	let count = int(trim(read(CONNTRACK_COUNT))) ?? 0;
	let max = int(trim(read(CONNTRACK_MAX))) ?? 0;

	return { conntrack: count, conntrack_max: max };
}

/* ---------------- bridge port counters ---------------- */

/*
 * Byte counters of every bridge member, straight from the kernel: the DSA
 * ports report the switch hardware counters, the wireless netdevs count
 * everything their radio moved.
 *
 * On a routed box these add nothing conntrack does not say better. On a
 * bridging device they are the only traffic figure that survives the offload:
 * the flows are still tracked, but the PPE answers the packets and the
 * conntrack accounting stays at zero - verified on target, where a wireless
 * client showed 223 WAN flows and not one counted byte. The overview reads
 * these instead when the device turns out to be a bridge.
 *
 * A bridge member named "wan" is what marks that mode: on a router the wan
 * port is routed and never a bridge member, so finding one inside a brif
 * means the uplink was bridged into the LAN - an AP. Its counters are the
 * WAN figure; the sum of the other members, minus what crossed the uplink,
 * is the traffic between this device's own clients.
 */
/* One interface counter, or null if the device has no statistics node. */
function counter(dev, field) {
	let raw = read('/sys/class/net/' + dev + '/statistics/' + field);

	if (raw == null)
		return null;

	let value = int(trim(raw));

	return (value != null) ? value : null;
}

/* Every bridge on the box and its member counters, read straight from sysfs.
 *
 * This used to shell out: a `for d in /sys/class/net/*` loop that also forked
 * `basename` twice per member. Measured on target at 25 ms - and it is on the
 * path of a sampler that has to fit a whole pass into one second, so it is now
 * two opendir walks and a handful of small reads, about 2 ms.
 */
function port_scan() {
	let ports = {};
	let bridges = {};
	let net = fs.opendir('/sys/class/net');

	if (net == null)
		return { ports: ports, bridges: bridges };

	let dev;

	while ((dev = net.read()) != null) {
		if (dev == '.' || dev == '..')
			continue;

		let brif = fs.opendir('/sys/class/net/' + dev + '/brif');

		if (brif == null)
			continue;

		let list = [];
		let member;

		while ((member = brif.read()) != null) {
			if (member == '.' || member == '..')
				continue;

			push(list, member);

			if (ports[member] != null)
				continue;

			let rx = counter(member, 'rx_bytes');
			let tx = counter(member, 'tx_bytes');

			if (rx == null || tx == null)
				continue;

			ports[member] = { rx: rx, tx: tx };
		}

		brif.close();

		if (length(list))
			bridges[dev] = list;
	}

	net.close();

	return { ports: ports, bridges: bridges };
}

/* The port table of the bridge that carries the clients.
 *
 * One bridge, not all of them: this fleet has a second bridge for IPTV
 * (br-iptv, with the multicast and service ports on it), and its members are
 * not LAN traffic. Summing every bridge would put the television stream into
 * the LAN figure - the same mistake nlbwmon makes, which is why the WAN column
 * had to be corrected for it once already.
 *
 * `br-lan` is the name OpenWrt gives it; anything else is a guess, and the
 * widest bridge is the least bad one.
 */
function port_counters() {
	let scan = port_scan();
	let chosen = null;
	let ports = {};
	let members = [];
	let bridges = {};
	let uplink = null;

	if (scan.bridges['br-lan'] != null) {
		chosen = 'br-lan';
	}
	else {
		let best = -1;

		for (let name, list in scan.bridges) {
			if (length(list) > best) {
				best = length(list);
				chosen = name;
			}
		}
	}

	if (chosen != null) {
		bridges[chosen] = scan.bridges[chosen];

		for (let member in bridges[chosen]) {
			if (scan.ports[member] == null)
				continue;

			ports[member] = scan.ports[member];
			push(members, member);

			if (member == 'wan')
				uplink = member;
		}
	}

	return {
		name: chosen,
		mode: uplink != null,
		uplink: uplink,
		members: members,
		ports: ports,
		bridges: bridges
	};
}

/* The interface whose counters are the WAN figure.
 *
 * On an AP that is a bridge member named "wan", and port_counters() already has
 * it. On a router the uplink is routed, no bridge contains it, and it has to be
 * found by name - but it still belongs in the same table, because the LAN
 * figure is the member sum minus what crossed the uplink. Both numbers have to
 * come from one consistent read or the subtraction is between two different
 * moments.
 */
function wan_device(bridge) {
	if (bridge?.uplink != null)
		return bridge.uplink;

	for (let dev in WAN_CANDIDATES)
		if (counter(dev, 'rx_bytes') != null)
			return dev;

	return null;
}

/* ---------------- nlbwmon long-term counters ---------------- */

/*
 * nlbwmon is the long-term counter this page does not try to reinvent. It
 * listens on the conntrack netlink socket, so it sees a stream twice - when it
 * is created and, more importantly, when it is destroyed, with the final byte
 * counts attached - and it refreshes the counters of still-established streams
 * every 30 seconds.
 *
 * A timer that samples /proc/net/nf_conntrack can never do that. Measured on
 * this fleet: five seconds of ordinary traffic retired enough rows to drop the
 * table total from 1,059,211 to 1,057,753 bytes. A stream that opens and closes
 * between two samples is simply invisible, so sampling can only ever produce a
 * floor - which is exactly what the live columns in the page say they are.
 *
 * nlbwmon also keeps working with the hardware offload on, because it reads the
 * same accounting counters the driver writes back for PPE-offloaded flows.
 *
 * It is optional. Without /usr/sbin/nlbw the live counters still work and every
 * long-term column stays empty - the page does not fail.
 */
const NLBW = '/usr/sbin/nlbw';

function nlbw_available() {
	return length(trim(run('test -x ' + NLBW + ' && echo yes'))) > 0;
}

function nlbw_usage(period) {
	let cmd = NLBW + ' -c json';

	if (period != null && length(period))
		cmd += ' -t ' + period;

	/* Group by MAC alone: the page joins on MAC, and grouping by ip or layer7 as
	 * well would split one device into several rows that this function would
	 * then have to add back together anyway. */
	cmd += ' -g mac -o -rx_bytes,-tx_bytes';

	let raw = run(cmd + ' 2>/dev/null');
	let data = null;

	try {
		data = json(raw);
	}
	catch (e) {
		return null;
	}

	if (data == null || type(data.columns) != 'array' || type(data.data) != 'array')
		return null;

	/*
	 * nlbw reports the column names as an array and the rows positionally:
	 *
	 *   {"columns":["mac","conns","rx_bytes","rx_pkts","tx_bytes","tx_pkts"],
	 *    "data":[["04:56:65:8a:2e:85",22,1676260,611,90173,502]]}
	 *
	 * The order is whatever -g asked for, so the name -> position map has to be
	 * built rather than assumed. Reading columns.mac off an array yields
	 * undefined and every field silently reads as zero, which is exactly how
	 * this looked like "no traffic" on the first run against a live nlbwmon.
	 */
	let index = {};

	for (let i = 0; i < length(data.columns); i++)
		index[data.columns[i]] = i;

	let map = {};

	for (let record in data.data) {
		let mac = record[index.mac] ?? '';

		if (type(mac) != 'string' || !match(lc(mac), /^[0-9a-f]{2}(:[0-9a-f]{2}){5}$/))
			continue;
		if (lc(mac) == '00:00:00:00:00:00')
			continue;

		let key = uc(mac);
		let entry = map[key] ?? { up: 0, down: 0, conns: 0 };

		/* rx_bytes is what arrived at the local network - a download for the
		 * client; tx_bytes is what left it. Verified against a live device:
		 * 1.67 MB rx against 90 KB tx for a host that mostly downloads. */
		entry.down += int(record[index.rx_bytes] ?? 0) ?? 0;
		entry.up += int(record[index.tx_bytes] ?? 0) ?? 0;

		if (index.conns != null)
			entry.conns += int(record[index.conns] ?? 0) ?? 0;

		map[key] = entry;
	}

	return map;
}

/*
 * Fold nlbwmon's per-MAC byte counters into the conntrack-driven traffic map.
 *
 * Some platforms hardware-offload flows (the `[HW_OFFLOAD]` tag in
 * /proc/net/nf_conntrack) and the offload driver does NOT write the byte
 * counters back into the conntrack entry - every offloaded flow reads
 * bytes=0, so a routed box that leans on the offload shows a "Clients" table
 * where every host has zero traffic. nlbwmon listens on the same conntrack
 * netlink socket the driver reports into, so it still accumulates the bytes
 * (and the flow count) for those offloaded streams.
 *
 * The merge is keyed through the address-to-MAC tables already built for the
 * PTR pass, so the page's existing rate/total differentiation needs no change:
 * nlbwmon's rx_bytes is what the client received (download), tx_bytes what it
 * sent (upload), and both go into the WAN bucket because nlbwmon groups by MAC
 * alone and cannot tell LAN from WAN. The LAN half is left at zero; Total
 * still adds up to the WAN figure, which for an internet client is the number
 * that matters.
 *
 * Where conntrack byte accounting is already non-zero (no offload, or a
 * bridging AP whose port counters already cover it) this is a no-op, so the
 * original path is left untouched and the LAN/WAN split it computes survives.
 */
function nlbw_into_traffic(hosts, ipMac) {
	if (!nlbw_available())
		return false;

	/*
	 * A box with hardware offload is a mix, not an all-or-nothing: some flows
	 * are tracked (conntrack bytes intact) and some are offloaded (bytes=0,
	 * entry still present). So the decision is per-host - fill a host's bytes
	 * from nlbwmon only when its own conntrack bytes are zero - rather than a
	 * global "all conntrack zero" gate that would miss exactly the offloaded
	 * hosts this exists to rescue (on 30.1 ~1252 of ~1700 entries read
	 * bytes=0 while the rest still count).
	 */
	let usage = nlbw_usage(null);

	if (usage == null)
		return false;

	/* A single client MAC answers on several addresses - an IPv4 lease and
	 * the EUI-64 IPv6 derived from the same MAC are the common case. The
	 * reverse map must therefore be MAC -> [all its IPs], not MAC -> one IP,
	 * or only the last address would inherit the nlbwmon bytes and the IPv4
	 * (or IPv6) sibling would stay at zero. */
	let mac_ips = {};

	for (let ip in ipMac)
		if (ipMac[ip]) {
			let m = ipMac[ip];

			if (mac_ips[m] == null)
				mac_ips[m] = [];

			push(mac_ips[m], ip);
		}

	let used = false;

	for (let key, entry in usage) {
		let ips = mac_ips[key];

		if (ips == null)
			continue;

		let conntrack_total = 0;

		for (let ip in ips)
			conntrack_total += (hosts[ip]?.up || 0) + (hosts[ip]?.down || 0);

		let nlbw_total = (entry.up || 0) + (entry.down || 0);

		/* nlbwmon accumulates the same driver accounting conntrack reads, so
		 * it is always a superset - it never loses flows that opened and
		 * closed between two /proc snapshots. Use it only when conntrack is
		 * clearly missing the device (zero bytes, or a sliver next to
		 * nlbwmon's total, which is what a few non-offloaded flows leave
		 * behind on an otherwise offloaded host). Otherwise keep conntrack,
		 * which still carries the LAN/WAN split. */
		if (nlbw_total <= 0 || nlbw_total <= conntrack_total * 2)
			continue;

		/* The device is offloaded. Carry nlbwmon's MAC-wide total on a single
		 * address - preferring IPv4 so the WAN figure lands beside the
		 * connection count - and leave the other addresses at their (zero)
		 * conntrack counters. The page then sums exactly one copy instead of
		 * multiplying the same total over every address of a dual-stack host. */
		let rep = null;

		for (let ip in ips)
			if (index(ip, ':') < 0) {
				rep = ip;
				break;
			}

		if (rep == null)
			rep = ips[0];

		let h = hosts[rep];

		if (h == null) {
			h = {
				up: 0, down: 0, conns: 0,
				lan: { up: 0, down: 0, conns: 0 },
				wan: { up: 0, down: 0, conns: 0 }
			};
			hosts[rep] = h;
		}

		/* rx_bytes = client received = download; tx_bytes = client sent =
		 * upload. Verified against a live device. The LAN/WAN split is gone
		 * (nlbwmon groups by MAC alone) so both bytes go to WAN; LAN stays
		 * zero. Connections keep coming from conntrack - the concurrent-flow
		 * count, matching the 20.1 reference - so nlbwmon's lifetime conn
		 * count is only used when conntrack recorded nothing for this
		 * address. */
		h.up = entry.up;
		h.down = entry.down;
		h.wan.up = entry.up;
		h.wan.down = entry.down;
		h.lan.up = 0;
		h.lan.down = 0;

		/* conntrack under-reports a device whose flows are offloaded - their
		 * entries drop out - so its concurrent count is tiny right where the
		 * bytes are. Since nlbwmon is already authoritative for this device's
		 * traffic, take its connection count too, so the bytes and the
		 * connection column agree on which source described the device. */
		if (entry.conns)
			h.conns = entry.conns;

		used = true;
	}

	return used;
}

/*
 * The accounting periods nlbwmon has on disk, oldest first. The configured
 * interval decides what a period means - the package default starts a new one
 * on the first of every month, which is what the page labels it as.
 */
function nlbw_periods() {
	let list = [];
	let lines = split(trim(run(NLBW + ' -c list 2>/dev/null')), '\n');

	for (let line in lines) {
		let text = trim(line);

		if (match(text, /^[0-9]{4}-[0-9]{2}-[0-9]{2}$/))
			push(list, text);
	}

	return list;
}

/* ---------------- snapshot ---------------- */

/* ucode initialises top-level functions in statement order, so the helpers a
 * function calls must be declared above it. */
function valid_mac_text(text) {
	if (type(text) != 'string' || !match(lc(text), /^[0-9a-f]{2}(:[0-9a-f]{2}){5}$/))
		return null;

	if (lc(text) == '00:00:00:00:00:00')
		return null;

	return uc(text);
}

function valid_ip4_text(text) {
	if (type(text) != 'string' || !match(text, /^[0-9]{1,3}(\.[0-9]{1,3}){3}$/))
		return null;

	for (let part in split(text, '.'))
		if (int(part) > 255)
			return null;

	return text;
}

/*
 * Read what clients-snoop learned by listening on the bridge. On a bridging
 * device (AP mode) the local daemon stack owns no addresses: dnsmasq leases
 * nothing, the kernel never resolves a client's global IPv6 address, and the
 * only place the assignments are visible is the traffic crossing the bridge.
 * The snoop file carries that - DHCPACK assignments per MAC and IPv6
 * addresses learned from neighbour discovery - plus the Host-Name option the
 * clients themselves sent, keyed by MAC. The names are not freshness-gated:
 * a hostname learned three days ago is still the best answer for that MAC,
 * which is exactly why the lease file is read the same way.
 */
function snoop_state() {
	let raw = read(SNOOP_FILE);
	let parsed = null;

	if (!length(raw))
		return null;

	try {
		parsed = json(raw);
	}
	catch (e) {
		parsed = null;
	}

	if (parsed == null || type(parsed) != 'object')
		return null;

	let dhcp4 = (type(parsed.dhcp4) == 'object') ? parsed.dhcp4 : {};
	let hosts6 = (type(parsed.hosts6) == 'object') ? parsed.hosts6 : {};
	let snoop4 = [];
	let snoop6 = [];
	let names = {};
	let cutoff = time() - SNOOP_FRESH;

	for (let mac, entry in dhcp4) {
		let hw = valid_mac_text(mac);

		if (hw == null || valid_ip4_text(entry?.ip) == null)
			continue;

		push(snoop4, { mac: hw, ip: entry.ip });
	}

	for (let mac, host in hosts6) {
		let hw = valid_mac_text(mac);

		if (hw == null || type(host) != 'object')
			continue;

		for (let ip, ts in host) {
			if (index(ip, ':') < 0)
				continue;

			push(snoop6, {
				mac: hw,
				ip: ip,
				fresh: (int(ts) ?? 0) >= cutoff
			});
		}
	}

	if (type(parsed.names) == 'object')
		for (let mac, entry in parsed.names) {
			let hw = valid_mac_text(mac);
			let name = entry?.name;

			if (hw == null || type(name) != 'string' || !length(name))
				continue;

			names[hw] = name;
		}

	return { snoop4: snoop4, snoop6: snoop6, names: names };
}

/* ---------------- PTR hostnames ---------------- */

/*
 * The passive sources are slow by nature: the lease file only exists where
 * this box runs dnsmasq, the Host-Name option only crosses the bridge when a
 * client happens to renew. On a routed box the one source that answers
 * immediately is DNS itself - this box's own dnsmasq registers every lease
 * it hands out under in-addr.arpa, so a reverse query for a client address
 * returns its hostname.
 *
 * The whole pass is skipped on a bridging device (AP mode): there the
 * answering server would be the upstream router, and an AP does not get to
 * ask the network for names - it only listens. On a router the device's own
 * LAN addresses come first in the candidate list, so the queries stay local
 * even when resolv.conf.auto names upstream resolvers as fallback.
 * Everything is cached with a TTL (short for NXDOMAIN, so a client that
 * later obtains a lease is noticed), and a run queries at most a handful of
 * names: a busy table costs a few cycles, never a burst.
 */
const PTR_CACHE = '/tmp/clients-ptr.json';
const PTR_TTL_POS = 6 * 3600;
const PTR_TTL_NEG = 600;
const PTR_QUERIES_PER_RUN = 8;

function ptr_cache_load() {
	let raw = read(PTR_CACHE);
	let parsed = null;

	if (length(raw))
		try {
			parsed = json(raw);
		}
		catch (e) {
			parsed = null;
		}

	if (parsed == null || type(parsed) != 'object' || type(parsed.ptr) != 'object')
		return { server: null, server_ts: 0, ptr: {} };

	return parsed;
}

function ptr_cache_save(cache) {
	let text = sprintf('%J\n', cache);

	if (fs.writefile(PTR_CACHE + '.new', text) == length(text)) {
		try {
			fs.chmod(PTR_CACHE + '.new', 0600);
		}
		catch (e) {}

		fs.rename(PTR_CACHE + '.new', PTR_CACHE);
	}
}

/* Where to ask: the device's own LAN addresses first (that is where a local
 * dnsmasq listens), then every non-loopback resolver the resolv files name. */
function dns_servers(local) {
	let list = [];

	for (let ip in local)
		if (match(ip, /^[0-9.]+$/) && index(list, ip) < 0)
			push(list, ip);

	let lines = split(read('/tmp/resolv.conf.d/resolv.conf.auto') + '\n' + read('/etc/resolv.conf'), '\n');

	for (let line in lines) {
		let ns = match(line, /^nameserver[ \t]+([0-9a-fA-F.:]+)/);

		if (ns == null)
			continue;

		let server = ns[1];

		if (match(server, /^127\.|^0\.0\.0\.0$|^255\.|^fe80/) || server == '::1')
			continue;

		if (index(list, server) < 0)
			push(list, server);
	}

	return list;
}

function search_domains() {
	let domains = [];
	let lines = split(read('/tmp/resolv.conf.d/resolv.conf.auto') + '\n' + read('/etc/resolv.conf'), '\n');

	for (let line in lines) {
		let m = match(line, /^search[ \t]+(.+)$/);

		if (m == null)
			continue;

		for (let d in split(trim(m[1]), /[ \t]+/))
			if (match(d, /^[A-Za-z0-9._-]+$/) && index(domains, d) < 0)
				push(domains, d);
	}

	return domains;
}

/* Strip the trailing dot and the search domain, then keep only names a page
 * can print - tcpdump's escaping rule applies to DNS answers just the same. */
function ptr_clean(text, domains) {
	if (type(text) != 'string')
		return null;

	text = trim(text);

	while (length(text) > 1 && substr(text, length(text) - 1) == '.')
		text = substr(text, 0, length(text) - 1);

	for (let d in domains) {
		let suffix = '.' + d;

		if (length(text) > length(suffix) && substr(text, length(text) - length(suffix)) == suffix)
			text = substr(text, 0, length(text) - length(suffix));
	}

	let len = length(text);

	if (len < 1 || len > 64)
		return null;

	for (let i = 0; i < len; i++) {
		let code = ord(text, i);

		if (code < 32 || code > 126 || code == 92)
			return null;
	}

	return text;
}

/* One reverse query, walking the server candidates until one answers. A
 * definitive NXDOMAIN is an answer too ('' = negative, cached briefly); a
 * server that never replies is skipped and the remembered one is dropped. */
function ptr_query(ip, servers, domains, cache) {
	let start = 0;

	for (let i = 0; i < length(servers); i++)
		if (servers[i] == cache.server)
			start = i;

	for (let i = 0; i < length(servers); i++) {
		let server = servers[(start + i) % length(servers)];
		let out = run('timeout 3 nslookup ' + ip + ' ' + server + ' 2>/dev/null');
		let ans = null;

		if (out != null && length(out)) {
			ans = match(out, /in-addr\.arpa[ \t]+name[ \t]*=[ \t]*([A-Za-z0-9._-]+)/) ??
				match(out, /[ \t]name[ \t]*=[ \t]*([A-Za-z0-9._-]+)/);

			if (ans == null && match(out, /NXDOMAIN/)) {
				cache.server = server;
				cache.server_ts = time();

				return '';
			}

			if (ans != null) {
				cache.server = server;
				cache.server_ts = time();

				return ptr_clean(ans[1], domains);
			}
		}
	}

	/* Nothing answered: forget the remembered server so the next query
	 * starts from the top of the candidate list. */
	cache.server = null;

	return null;
}

/* Fill names the lease file, the hints and the wire left open, keyed through
 * the address-to-MAC tables this snapshot already built. */
function ptr_names(names, ipMac, candidates, local) {
	if (!length(candidates))
		return;

	let servers = dns_servers(local);

	if (!length(servers))
		return;

	let cache = ptr_cache_load();
	let domains = search_domains();
	let now = time();
	let budget = PTR_QUERIES_PER_RUN;
	let changed = false;

	for (let ip in candidates) {
		let mac = ipMac[ip];

		if (mac == null || names[mac] != null)
			continue;

		let hit = cache.ptr[ip];
		let name;

		if (hit != null && type(hit.name) == 'string' &&
		    (now - (int(hit.ts) ?? 0)) < ((hit.name == '') ? PTR_TTL_NEG : PTR_TTL_POS)) {
			name = hit.name;
		}
		else if (budget > 0) {
			budget--;

			name = ptr_query(ip, servers, domains, cache);

			if (name == null)
				continue;

			cache.ptr[ip] = { name: name, ts: now };
			changed = true;
		}
		else {
			continue;
		}

		if (name != '')
			names[mac] = name;
	}

	/* The cache follows the same bound as the snoop tables. */
	let ips = keys(cache.ptr);

	while (length(ips) > 512) {
		let oldest = null;
		let oldest_at = 0;

		for (let i = 0; i < length(ips); i++) {
			let at = int(cache.ptr[ips[i]]?.ts) ?? 0;

			if (oldest == null || at < oldest_at) {
				oldest = ips[i];
				oldest_at = at;
			}
		}

		if (oldest == null)
			break;

		delete cache.ptr[oldest];
		ips = keys(cache.ptr);
		changed = true;
	}

	if (changed)
		ptr_cache_save(cache);
}

/*
 * IP -> MAC as far as the neighbours know it. ARP wins: it speaks for the
 * address that is live right now, and the snooped tables only fill the gaps
 * ARP leaves on a bridging device.
 */
function ip_mac_map(arp, snoop) {
	let map = {};

	for (let entry in arp)
		if (map[entry.ip] == null)
			map[entry.ip] = entry.mac;

	for (let entry in (snoop?.snoop4 ?? []))
		if (map[entry.ip] == null)
			map[entry.ip] = entry.mac;

	for (let entry in (snoop?.snoop6 ?? []))
		if (map[entry.ip] == null)
			map[entry.ip] = entry.mac;

	return map;
}

function snapshot(withPtr) {
	let lan = lan_state();
	let devices = device_names(lan.interfaces);
	let arp = arp_entries(devices);
	let neigh6 = neighbour6(devices);
	let hosts = traffic(all_subnets(lan.interfaces), lan.local);
	let wifi = wifi_state();
	let wifiMap = wifi[0];
	let wifiRadios = wifi[1];
	let leases = dhcp_leases();
	let names = host_names(leases);
	let snoop = snoop_state();
	let bridge = port_counters();
	let wan = wan_device(bridge);

	/* The uplink belongs in the port table even when it is not a bridge
	 * member. The LAN figure is the member sum minus what crossed it, so both
	 * ends of the subtraction have to be read at the same moment and carried
	 * in the same object - otherwise the page and the sampler end up
	 * differencing numbers taken seconds apart. */
	if (wan != null && bridge.ports[wan] == null) {
		let rx = counter(wan, 'rx_bytes');
		let tx = counter(wan, 'tx_bytes');

		if (rx != null && tx != null)
			bridge.ports[wan] = { rx: rx, tx: tx };
	}

	/* Names the clients reported themselves (DHCP option 12, heard on the
	 * bridge) fill the gaps the lease file and the hints leave open - which
	 * on a bridging device is all of them, since neither source exists
	 * there. A locally served lease outranks what was overheard, so snoop
	 * only ever completes the map, never overrides it. */
	for (let mac, name in snoop?.names ?? {})
		if (names[mac] == null)
			names[mac] = name;

	/* Last source, first answer - and only when someone is watching. The
	 * page pulls this live snapshot every few seconds, so the pass runs
	 * there, driven by the viewer; the background collector passes false
	 * and never spawns an nslookup. On a bridging device (AP mode) it is
	 * skipped even here: the answering server would be the upstream router,
	 * and an AP does not ask the network for names - it listens to the wire
	 * (the DHCP Host-Name option above) and accepts what it hears. The
	 * cache TTLs keep a watched page from re-asking names it already
	 * resolved. */
	let ipMac = ip_mac_map(arp, snoop);

	/* Where the offload has zeroed conntrack's byte counters, replace them with
	 * nlbwmon's offload-safe per-MAC bytes so the page shows real traffic. No
	 * nlbwmon, or conntrack already counting, leaves this a no-op. */
	let nlbw_used = nlbw_into_traffic(hosts, ipMac);

	let candidates = [];

	for (let ip in ipMac)
		if (index(lan.local, ip) < 0)
			push(candidates, ip);

	if (withPtr && !bridge.mode)
		ptr_names(names, ipMac, candidates, lan.local);

	/* Every address ARP resolved belongs in the answer even with zero counters,
	 * so the page can list a host that has not spoken yet. The scope sub-objects
	 * are created here too: the page reads them unconditionally. */
	for (let entry in arp)
		if (hosts[entry.ip] == null)
			hosts[entry.ip] = {
				up: 0, down: 0, conns: 0,
				lan: { up: 0, down: 0, conns: 0 },
				wan: { up: 0, down: 0, conns: 0 }
			};

	/*
	 * Carry the hostname on the ARP row. The page could look names up itself,
	 * but doing it once here means the row is named even on the first render,
	 * and the same table feeds the archive two functions down.
	 */
	for (let entry in arp)
		if (entry.name == null && names[entry.mac] != null)
			entry.name = names[entry.mac];

	/* Tag each counter row with the network it arrived on. conntrack does not
	 * say which interface a flow used, but the neighbour cache does for the same
	 * address - falling back to the IPv6 cache for a v6-only host. */
	let deviceOf = {};

	for (let entry in arp)
		deviceOf[entry.ip] = entry.device;
	for (let entry in neigh6)
		if (deviceOf[entry.ip] == null)
			deviceOf[entry.ip] = entry.device;

	for (let ip in hosts)
		if (deviceOf[ip] != null)
			hosts[ip].device = deviceOf[ip];

	let networks = [];

	for (let entry in lan.interfaces) {
		let subnets = [];

		for (let subnet in entry.subnets)
			push(subnets, subnet.text);

		push(networks, {
			iface: entry.iface,
			device: entry.device,
			vlan: entry.vlan,
			subnets: subnets
		});
	}

	return {
		ts: time(),
		interfaces: networks,
		arp: arp,
		neigh6: neigh6,
		wifi: wifiMap,
		wifi_radios: wifiRadios,
		names: names,
		traffic: hosts,
		stats: conntrack_stats(),
		bridge: {
			mode: bridge.mode,
			uplink: bridge.uplink,
			/* The device the LAN figure is measured against - a bridge member
			 * on an AP, pppoe-wan or wan on a router. */
			wan: wan,
			lan: bridge.name,
			members: bridge.members,
			ports: bridge.ports
		},
		nlbw_used: nlbw_used,
		snoop4: snoop?.snoop4 ?? [],
		snoop6: snoop?.snoop6 ?? []
	};
}

/* ---------------- live cache ---------------- */

/*
 * The counters in `traffic` and in `bridge.ports` are absolute. Turning them
 * into a rate needs the previous pass, and that is the whole reason the cache
 * exists: the knowledge is kept next to the numbers on disk instead of in a
 * browser tab, so a reader only has to subtract nothing - it reads `rates`.
 */

function cache_load(path) {
	let raw = read(path);

	if (!length(raw))
		return null;

	try {
		return json(raw);
	}
	catch (e) {
		return null;
	}
}

function zero_counters() {
	return { up: 0, down: 0, lanUp: 0, lanDown: 0, wanUp: 0, wanDown: 0 };
}

/* The traffic row keeps its LAN/WAN split nested; the page and the rate maths
 * both want it flat, and a snapshot file is smaller flat too. */
function flat_counters(entry) {
	return {
		up: entry?.up ?? 0,
		down: entry?.down ?? 0,
		lanUp: entry?.lan?.up ?? 0,
		lanDown: entry?.lan?.down ?? 0,
		wanUp: entry?.wan?.up ?? 0,
		wanDown: entry?.wan?.down ?? 0
	};
}

/* `acc` is the running total; only the keys that actually moved are touched, so
 * a device that is idle keeps the total it had. */
function accumulate(acc, before, cur, dt, rate) {
	for (let key in rate) {
		let delta = cur[key] - before[key];

		/* A flow can expire between two passes and take its bytes with it. A
		 * negative delta is clamped instead of being reported as a spike in
		 * the opposite direction. */
		if (delta < 0)
			delta = 0;

		rate[key] = int((delta / dt) + 0.5);
		acc[key] = (acc[key] ?? 0) + delta;
	}
}

function traffic_derive(data, prev) {
	let prev_traffic = prev?.traffic ?? {};
	let prev_totals = prev?.totals ?? {};
	let dt = data.ts - (int(prev?.ts) ?? 0);
	let fresh = (dt > 0 && dt <= RATE_MAX_GAP);
	let rates = {};
	let totals = {};

	for (let ip, current in data.traffic) {
		let acc = prev_totals[ip] ?? zero_counters();
		let rate = zero_counters();

		if (fresh && prev_traffic[ip] != null)
			accumulate(acc, flat_counters(prev_traffic[ip]), flat_counters(current), dt, rate);

		rates[ip] = rate;
		totals[ip] = acc;
	}

	data.rates = rates;
	data.totals = totals;
	data.rate_window = fresh ? dt : 0;
}

/* The bridge ports get the same treatment. On a bridging device this is where
 * the overview's rates come from: the port counters are hardware and keep
 * counting through the offload that freezes conntrack at zero. */
function bridge_derive(data, prev) {
	if (data.bridge == null)
		return;

	let prev_ports = prev?.bridge?.ports ?? {};
	let prev_totals = prev?.bridge?.totals ?? {};
	let dt = data.ts - (int(prev?.ts) ?? 0);
	let fresh = (dt > 0 && dt <= RATE_MAX_GAP);
	let rates = {};
	let totals = {};

	for (let dev, port in (data.bridge.ports ?? {})) {
		let acc = prev_totals[dev] ?? { rx: 0, tx: 0 };
		let rate = { rx: 0, tx: 0 };

		if (fresh && prev_ports[dev] != null)
			accumulate(acc, { rx: prev_ports[dev].rx ?? 0, tx: prev_ports[dev].tx ?? 0 },
				{ rx: port.rx ?? 0, tx: port.tx ?? 0 }, dt, rate);

		rates[dev] = rate;
		totals[dev] = acc;
	}

	data.bridge.rates = rates;
	data.bridge.totals = totals;
}

/* ---------------- inner-LAN traffic (nft bridge counter) ---------------- */

/*
 * Two clients on the same subnet are forwarded by the bridge at layer 2: no
 * conntrack entry is ever created, so every counter this file reads elsewhere
 * stays at zero for that traffic. The bridge family is the one place the kernel
 * exposes it, and a counter rule there sees exactly the frames that were
 * switched between two ports of the LAN bridge.
 *
 * What the rule deliberately does NOT count:
 *
 *   - frames the router itself sends or receives - they enter the input or
 *     output hook, never forward;
 *   - on an AP, anything that crossed the uplink port. There "wan" is a member
 *     of the LAN bridge, so a bridged WAN frame also enters and leaves through
 *     it; excluding that port by name is what leaves only client-to-client.
 *
 * The counter has no direction: both ends of the exchange are clients, so
 * "up" and "down" have no meaning here and the page shows one figure.
 *
 * The table is created once by `intra-setup`, which the service runs when it
 * starts, so the sampling loop below only ever reads it. Verified on target
 * (nft 1.1.7): the br-iptv table's `meta ibrname` matcher works the same way
 * and the exclusive counter moved only for frames that stayed inside the
 * bridge.
 */
const INTRA_TABLE = 'clients_intra';
const INTRA_COMMENT = 'intra-lan';

/*
 * Which bridge carries the clients, and which of its members is the uplink.
 * `br-lan` is the name OpenWrt gives it; anything else is a guess, and the
 * counter is not worth guessing wrong about too hard - if there is no bridge
 * the feature reports itself unavailable and the page leaves the row out.
 */
function lan_bridge() {
	/* The choice lives in port_counters() so that the counter, the sampler
	 * and the page all name the same bridge. */
	let pc = port_counters();

	return { bridge: pc.name, uplink: pc.uplink };
}

/* Reads the rule's own counters back out of nft's JSON, including the bridge
 * name it was built for, so the sampler never has to rediscover either. */
function intra_read() {
	let raw = trim(run('nft -j list table bridge ' + INTRA_TABLE + ' 2>/dev/null'));

	if (length(raw) == 0)
		return { ok: false };

	let doc = null;

	try {
		doc = json(raw);
	}
	catch (e) {
		return { ok: false };
	}

	if (type(doc?.nftables) != 'array')
		return { ok: false };

	for (let item in doc.nftables) {
		let rule = item?.rule;

		if (rule?.comment != INTRA_COMMENT)
			continue;

		let counter = null;
		let bridge = null;

		for (let expr in (rule.expr ?? [])) {
			if (expr?.counter != null)
				counter = expr.counter;

			if (expr?.match?.left?.meta?.key == 'ibrname')
				bridge = expr.match.right;
		}

		if (counter == null)
			return { ok: false };

		return {
			ok: true,
			bridge: bridge,
			packets: int(counter.packets) ?? 0,
			bytes: int(counter.bytes) ?? 0
		};
	}

	return { ok: false };
}

/*
 * (Re)builds the counter for the current topology. Rebuilding rather than
 * patching keeps this idempotent: the table is dropped and recreated with the
 * bridge and uplink of this boot, and a reset counter simply reads as "no
 * delta yet" on the next pass.
 */
function intra_setup() {
	let info = lan_bridge();

	if (info.bridge == null)
		return { ok: false, reason: 'no bridge' };

	let guard = '';

	if (info.uplink != null)
		guard = 'iifname != "' + info.uplink + '" oifname != "' + info.uplink + '" ';

	let cmd = 'nft delete table bridge ' + INTRA_TABLE + ' 2>/dev/null; '
		+ 'nft add table bridge ' + INTRA_TABLE + ' && '
		+ 'nft add chain bridge ' + INTRA_TABLE + ' forward "{ type filter hook forward priority filter; policy accept; }" && '
		+ 'nft add rule bridge ' + INTRA_TABLE + ' forward meta ibrname "' + info.bridge
		+ '" meta obrname "' + info.bridge + '" ' + guard
		+ 'counter comment "' + INTRA_COMMENT + '"';

	run(cmd);

	let now = intra_read();

	if (!now.ok)
		return { ok: false, reason: 'rule not loaded', bridge: info.bridge };

	now.bridge = info.bridge;
	now.uplink = info.uplink;
	now.counted = true;

	return now;
}

function intra_derive(data, prev) {
	let now = intra_read();

	if (!now.ok) {
		data.intra = { ok: false };
		return;
	}

	let dt = data.ts - (int(prev?.ts) ?? 0);
	let fresh = (dt > 0 && dt <= RATE_MAX_GAP);
	let before = (prev?.intra?.ok == true) ? int(prev.intra.bytes) : null;
	let total = (prev?.intra?.ok == true) ? (int(prev.intra.total) ?? 0) : 0;

	/* A rebuilt rule starts again from zero, so a counter that went backwards
	 * is a reset, not negative traffic: keep the running total, drop the rate
	 * for this pass. */
	if (before != null && now.bytes >= before) {
		let delta = now.bytes - before;

		total += delta;

		data.intra = {
			ok: true,
			bridge: now.bridge,
			packets: now.packets,
			bytes: now.bytes,
			rate: fresh ? int(delta / dt) : 0,
			total: total,
			window: fresh ? dt : 0
		};

		return;
	}

	data.intra = {
		ok: true,
		bridge: now.bridge,
		packets: now.packets,
		bytes: now.bytes,
		rate: 0,
		total: total,
		window: 0
	};
}

/* One aggregate point per collection pass: the four rates the chart draws,
 * whether this pass had a baseline, and the inner-LAN rate where the box has
 * that counter. No per-device series - the devices table is where a per-station
 * figure belongs, and carrying eight MACs through 180 points tripled the
 * snapshot for a chart that no longer reads them. */
function trend_append(data, prev) {
	let trend = (type(prev?.trend) == 'array') ? prev.trend : [];
	let point = { t: data.ts, valid: ((data.rate_window ?? 0) > 0) };

	/* One number, no direction: the counter in the bridge family sees a frame
	 * once, and both of its ends are clients. */
	if (data.intra?.ok == true)
		point.intra = data.intra.rate ?? 0;

	/* The four aggregate rates come from the port counters, on a router as
	 * much as on a bridge.
	 *
	 * They used to come from conntrack on a routed box, and on this fleet that
	 * read zero for LAN every single pass: two clients on the same bridge talk
	 * through the switch and never enter the flow table, so there was nothing
	 * to count. The port counters see those frames, and the sampler behind the
	 * tiles already reports them - sharing the formula is what keeps the
	 * coarse point and the fast ring from disagreeing at the seam where the
	 * chart switches from one to the other.
	 *
	 * Per-client rates stay on conntrack: it is the only thing that knows
	 * which address moved the bytes. */
	let wan = data.bridge?.wan ?? data.bridge?.uplink;
	let portRates = data.bridge?.rates;
	let l2 = null;

	if (portRates != null) {
		let local = { up: 0, down: 0 };
		let wide = { up: 0, down: 0 };

		for (let dev, r in portRates) {
			let bucket = (dev == wan) ? wide : local;

			/* rx on a member is a client's upload, tx its download; the
			 * uplink's counters face the other way. */
			bucket.up += (dev == wan) ? (r.tx ?? 0) : (r.rx ?? 0);
			bucket.down += (dev == wan) ? (r.rx ?? 0) : (r.tx ?? 0);
		}

		l2 = {
			wanUp: wide.up,
			wanDown: wide.down,
			lanUp: (local.up > wide.up) ? local.up - wide.up : 0,
			lanDown: (local.down > wide.down) ? local.down - wide.down : 0
		};
	}

	if (l2 != null) {
		point.lanUp = l2.lanUp;
		point.lanDown = l2.lanDown;
		point.wanUp = l2.wanUp;
		point.wanDown = l2.wanDown;
	}
	else {
		/* No port counters to read: the aggregate still has to come from
		 * somewhere, and the per-IP rates are what is left. */
		point.lanUp = 0;
		point.lanDown = 0;
		point.wanUp = 0;
		point.wanDown = 0;

		for (let ip, rate in (data.rates ?? {})) {
			point.lanUp += rate.lanUp ?? 0;
			point.lanDown += rate.lanDown ?? 0;
			point.wanUp += rate.wanUp ?? 0;
			point.wanDown += rate.wanDown ?? 0;
		}
	}

	push(trend, point);

	if (length(trend) > TREND_POINTS)
		trend = slice(trend, length(trend) - TREND_POINTS);

	data.trend = trend;
}

function file_bytes(path) {
	try {
		return fs.stat(path)?.size ?? 0;
	}
	catch (e) {
		return 0;
	}
}

/* `history_path` is configurable, so the directory a cache lives in may not
 * exist yet. Existing is the normal case; a failure here is not reported
 * because the write that follows says what actually went wrong. */
function mkdirp(dir) {
	let parts = split(dir, '/'), current = '';

	for (let part in parts) {
		if (part == '')
			continue;

		current += '/' + part;

		try {
			fs.mkdir(current);
		}
		catch (e) {}
	}
}

/*
 * Serialise a document under a hard byte ceiling. `drop` gives up one slice of
 * rows and answers false when there is nothing left to give up, at which point
 * the loop stops and what remains is written anyway - a cache that cannot be
 * made to fit is a bug in its shape, not a reason to fail the pass.
 *
 * The drop functions take an eighth of the rows at a time so this converges in
 * a handful of serialisations rather than one per row.
 */
function json_fit(data, max_bytes, drop) {
	/* A missing, zero or nonsensical ceiling falls back to the built-in one:
	 * a bounded cache is the point, so no configuration mistake may switch the
	 * guard off. */
	if (!(max_bytes > 0))
		max_bytes = DEFAULT_MAX_BYTES;

	let text = sprintf('%J\n', data);
	let trimmed = 0;

	while (length(text) > max_bytes) {
		if (!drop(data))
			break;

		trimmed++;
		text = sprintf('%J\n', data);
	}

	return [ text, trimmed ];
}

function write_capped(path, data, max_bytes, drop) {
	let fit = json_fit(data, max_bytes, drop);
	let text = fit[0];
	let cut = rindex(path, '/');

	if (cut > 0)
		mkdirp(substr(path, 0, cut));

	if (fs.writefile(path + '.new', text) != length(text))
		return null;

	try {
		fs.chmod(path + '.new', 0600);
	}
	catch (e) {}

	if (!fs.rename(path + '.new', path))
		return null;

	return { path: path, bytes: length(text), trimmed: fit[1] };
}

/* Keep the busiest `limit` traffic rows. The address the page would rank last
 * is the one that can go; ties break on the key so the choice is repeatable. */
function traffic_keep(data, limit) {
	let traffic = data.traffic ?? {};
	let names = keys(traffic);
	let count = length(names);

	if (count <= limit)
		return false;

	let ranked = [];

	for (let ip in names)
		push(ranked, [ ip, (traffic[ip]?.up ?? 0) + (traffic[ip]?.down ?? 0) ]);

	sort(ranked, (a, b) => (a[1] - b[1]) || ((a[0] < b[0]) ? -1 : (a[0] > b[0]) ? 1 : 0));

	for (let i = 0; i < count - limit; i++) {
		let ip = ranked[i][0];

		delete traffic[ip];

		if (data.rates != null)
			delete data.rates[ip];
		if (data.totals != null)
			delete data.totals[ip];
	}

	return true;
}

function traffic_drop(data) {
	let count = 0;

	for (let ip in (data.traffic ?? {}))
		count++;

	if (count == 0)
		return false;

	return traffic_keep(data, count - (int(count / 8) + 1));
}

/* The rest of the document, in the order it is worth losing. Rates go first
 * because they are the least durable thing in the file - a rate describes one
 * interval, while an address is a client. Then what the page only uses to
 * enrich a row (the snooped hints), then the rows themselves, and last the
 * associated-station table, whose loss makes a client "wired" rather than
 * hiding it. */
function list_shrink(list) {
	let count = length(list ?? []);

	if (count == 0)
		return false;

	splice(list, 0, int(count / 8) + 1);

	return true;
}

function map_shrink(map) {
	let names = keys(map ?? {});

	if (length(names) == 0)
		return false;

	/* No timestamp to rank by here; taking them in key order makes repeated
	 * passes make progress, which is all this needs. */
	for (let i = 0; i <= int(length(names) / 8); i++)
		delete map[names[i]];

	return true;
}

/* The trend is the reason the file exists, so it goes last: first the
 * per-device series (the aggregate line is what the chart is for), then the
 * points themselves, oldest eighth. */
function trend_drop(data) {
	let trend = data.trend;

	if (type(trend) != 'array' || !length(trend))
		return false;

	splice(trend, 0, int(length(trend) / 8) + 1);

	return true;
}

function snapshot_drop(data) {
	if (traffic_drop(data)) return true;
	if (list_shrink(data.snoop4)) return true;
	if (list_shrink(data.snoop6)) return true;
	if (list_shrink(data.arp)) return true;
	if (list_shrink(data.neigh6)) return true;
	if (map_shrink(data.names)) return true;
	if (map_shrink(data.wifi)) return true;
	if (trend_drop(data)) return true;

	return false;
}

function snapshot_write(path, snap, max_bytes) {
	traffic_keep(snap, MAX_TRAFFIC_ROWS);

	return write_capped(path, snap, max_bytes, snapshot_drop);
}

/* ---------------- fast sample ring ---------------- */

/*
 * The four tile figures on the cheap clock.
 *
 * Everything the roster needs is skipped: no ARP, no iw, no nlbwmon, no nft
 * beyond the intra counter, no names. What is left is the conntrack walk and
 * the port counters, which is exactly what the tiles are made of.
 */

function sample_load(path) {
	let state = cache_load(path);

	if (type(state?.samples) != 'array')
		return { samples: [], prev: null, macrates: null };

	return {
		samples: state.samples,
		prev: (type(state.prev) == 'object') ? state.prev : null,
		macrates: (type(state.macrates) == 'object') ? state.macrates : null
	};
}

/* A counter that went backwards is a reset - interface re-created, rule
 * rebuilt, every flow of a host expired at once - not negative traffic. */
function grew(now, before) {
	return (now > before) ? now - before : 0;
}

/* Port counters to the four scopes. rx on a member is a client's upload and tx
 * its download; the uplink's counters face the other way, and what it carried
 * is subtracted from the local side, because a frame forwarded to the uplink
 * did not stay inside the LAN.
 *
 * The page does the same arithmetic in bridgeRates() for the 10 s path. The
 * two have to agree, or the tile would jump the moment the ring has a gap. */
function sample_scopes(ports, before, uplink) {
	let local = { up: 0, down: 0 }, wan = { up: 0, down: 0 };

	for (let dev, cur in ports) {
		let was = (before != null) ? before[dev] : null;

		if (type(was) != 'array')
			continue;

		let rx = grew(int(cur?.rx) ?? 0, int(was[0]) ?? 0);
		let tx = grew(int(cur?.tx) ?? 0, int(was[1]) ?? 0);
		let bucket = (dev == uplink) ? wan : local;

		bucket.up += (dev == uplink) ? tx : rx;
		bucket.down += (dev == uplink) ? rx : tx;
	}

	return {
		wanUp: wan.up,
		wanDown: wan.down,
		lanUp: (local.up > wan.up) ? local.up - wan.up : 0,
		lanDown: (local.down > wan.down) ? local.down - wan.down : 0
	};
}

function sample_drop(data) {
	let samples = data.samples;

	if (type(samples) != 'array' || !length(samples))
		return false;

	/* The oldest point goes first, and a few with it: trimming one per write
	 * would run the whole fit loop on every tick once the file is over the
	 * ceiling. */
	splice(samples, 0, int(length(samples) / 4) + 1);

	return true;
}

/* Per-station WAN rates, on nlbwmon's own clock.
 *
 * The devices table wants a speed per station, and there is only one source
 * left for it here: the hardware offload freezes conntrack's byte counters
 * (measured on this fleet - 2.82 MB across the WAN in 43 s while every
 * conntrack counter added up to zero), and nlbwmon reads the accounting the
 * driver writes back for those flows.
 *
 * nlbwmon reconciles in batches, measured at every four to five seconds. A one
 * second pass over it would report four zeros and a spike - the same comb the
 * tiles had before the moving window - so this runs on a five second step,
 * which is the resolution the source actually has, and the page is told the
 * window it was divided by.
 *
 * It rides the ring's writer instead of getting a file of its own: two
 * processes renaming the same document lose each other's passes, and the page
 * already reads this one every second.
 */
const MAC_RATE_EVERY = 5;

function sample_macs(prev) {
	let now = time();
	let usage = nlbw_usage(null);
	let macs = {};
	let base = {};
	let before = (type(prev?.base) == 'object') ? prev.base : null;
	let since = int(before?.ts) ?? 0;
	let window = now - since;
	let valid = (window > 0 && window <= RATE_MAX_GAP);

	if (usage == null) {
		/* No nlbwmon on this box: say so with an empty table, and do not keep
		 * a stale one - a per-station speed that stopped moving is worse than
		 * no per-station speed. */
		return { ts: now, window: 0, macs: macs };
	}

	let count = 0;

	for (let mac, entry in usage) {
		if (count++ >= SAMPLE_HOSTS)
			break;

		base[mac] = [ entry.up, entry.down ];

		let was = (before != null && type(before.counters) == 'object') ? before.counters[mac] : null;

		if (!valid || type(was) != 'array')
			continue;

		macs[mac] = [
			int((grew(entry.up, int(was[0]) ?? 0) / window) + 0.5),
			int((grew(entry.down, int(was[1]) ?? 0) / window) + 0.5)
		];
	}

	return {
		ts: now,
		window: valid ? window : 0,
		macs: macs,
		base: { ts: now, counters: base }
	};
}

function tick(path, max_bytes, with_macs) {
	let state = sample_load(path);
	let prev = state.prev;
	let samples = state.samples;
	let now = time();
	let dt = now - (int(prev?.ts) ?? 0);
	let fresh = (dt > 0 && dt <= RATE_MAX_GAP);
	let bridge = port_counters();
	let uplink = wan_device(bridge);
	let cur = {};
	let ports = {};
	let deltas;

	/*
	 * Four numbers out of sysfs, and nothing else.
	 *
	 * The earlier version walked conntrack and merged nlbwmon on every pass,
	 * which measured 440 ms - a 1 s cadence cannot afford that, and it did not
	 * need to: the tile asks for aggregate bytes, and the interface counters
	 * answer that directly. Per-client attribution still needs conntrack and
	 * nlbwmon, but that belongs to the 10 s pass that draws the roster, not to
	 * the sampler that keeps the tile moving.
	 *
	 * The uplink is measured even when no bridge contains it. A router's WAN
	 * is a routed device - pppoe-wan here - so it is not a brif member, yet
	 * the LAN figure is the member sum minus what crossed it, and both numbers
	 * have to come from the same read or the subtraction mixes two moments.
	 */
	for (let dev, one in bridge.ports)
		cur[dev] = { rx: int(one?.rx) ?? 0, tx: int(one?.tx) ?? 0 };

	if (uplink != null && cur[uplink] == null) {
		let rx = counter(uplink, 'rx_bytes');
		let tx = counter(uplink, 'tx_bytes');

		if (rx != null && tx != null)
			cur[uplink] = { rx: rx, tx: tx };
	}

	for (let dev, one in cur)
		ports[dev] = [ one.rx, one.tx ];

	deltas = sample_scopes(cur, prev?.p, uplink);

	/*
	 * The window is a moving average, not the last tick on its own.
	 *
	 * These counters move in bursts - measured on target, an idle-looking
	 * network still accumulates 80 KB one second and nothing the next, because
	 * the accounting is reconciled in batches. A tick that lands in a gap
	 * reports zero, and at a one second cadence that turns the tile into a
	 * comb: 60 KB/s, 0, 80 KB/s, 0. Averaging the last few ticks hides the
	 * batch boundaries without inventing traffic: whatever went into the sum
	 * also came out of a counter.
	 *
	 * The window keeps itself around SAMPLE_SPAN seconds, so it works at any
	 * tick interval instead of assuming the configured one.
	 */
	let recent = (fresh && type(prev?.recent) == 'array') ? prev.recent : [];
	let scope = { wanUp: 0, wanDown: 0, lanUp: 0, lanDown: 0 };
	let span = 0;
	let sums = [ 0, 0, 0, 0 ];

	if (fresh)
		push(recent, [ deltas.wanUp, deltas.wanDown, deltas.lanUp, deltas.lanDown, dt ]);

	for (let entry in recent)
		span += int(entry[4]) ?? 0;

	while (length(recent) > 1 && span > SAMPLE_SPAN) {
		span -= int(recent[0][4]) ?? 0;
		splice(recent, 0, 1);
	}

	for (let entry in recent)
		for (let i = 0; i < 4; i++)
			sums[i] += int(entry[i]) ?? 0;

	if (span > 0) {
		scope.wanUp = int((sums[0] / span) + 0.5);
		scope.wanDown = int((sums[1] / span) + 0.5);
		scope.lanUp = int((sums[2] / span) + 0.5);
		scope.lanDown = int((sums[3] / span) + 0.5);
	}

	/* One row per tick: when it was measured, the four rates, the intra rate
	 * (-1: the frames two clients exchanged are already in the port counters
	 * this row was differenced from, and the page folds a number here), and
	 * the window they were divided by. A zero window marks a tick with no
	 * baseline, which the page uses to break the line instead of drawing a
	 * drop to zero. */
	push(samples, [ now, scope.wanUp, scope.wanDown, scope.lanUp, scope.lanDown,
		-1, span ]);

	if (length(samples) > SAMPLE_POINTS)
		samples = slice(samples, length(samples) - SAMPLE_POINTS);

	let macrates = state.macrates;

	/* Per-station speeds ride this writer rather than getting a file of their
	 * own, but only every MAC_RATE_EVERY ticks: that is as often as the source
	 * changes. */
	if (with_macs !== false)
		macrates = sample_macs(macrates);

	let written = write_capped(path, {
		ts: now,
		window: span,
		bridge: bridge.mode,
		samples: samples,
		macrates: macrates,
		/* What the next tick differences against, and the deltas not yet aged
		 * out of the moving window. Same file because it is the same writer
		 * and the same clock; the page ignores it. */
		prev: {
			ts: now,
			p: ports,
			recent: recent
		}
	}, max_bytes, sample_drop);

	return {
		ok: written != null,
		path: path,
		bytes: written?.bytes ?? 0,
		samples: length(samples),
		window: span,
		bridge: bridge.mode,
		uplink: uplink,
		scope: scope,
		trimmed: written?.trimmed ?? false
	};
}

/* Milliseconds on the monotonic clock: a cadence has to be measured against
 * something that does not step when the wall clock is corrected. */
function mono_ms() {
	let c = clock(true);

	return c[0] * 1000 + int(c[1] / 1000000);
}

/*
 * The sampler proper: one interpreter, one parse, a tick on every step.
 *
 * Starting `clients-probe tick` from a shell loop costs 40 ms before any work
 * happens - the interpreter reads and compiles this file every time - and at
 * one tick per second that alone is four percent of a core. Here the parse is
 * paid once and the loop only measures. Measured after the change: about 8 ms
 * per tick, under one percent.
 *
 * The sleep is shortened by however long the pass took, so the cadence does not
 * drift when a pass runs long; it is never shortened past MONO_FLOOR, because a
 * pass that somehow overruns its own interval must not turn into a busy loop.
 */
const MONO_FLOOR = 100;
const TICK_MAX_STEP = 60000;

function loop(path, max_bytes, interval) {
	let step = (int(interval) != null && int(interval) > 0) ? int(interval) : 1000;
	let last_macs = 0;

	if (step > TICK_MAX_STEP)
		step = TICK_MAX_STEP;

	while (true) {
		let started = mono_ms();
		/* The per-station table is taken on the first pass - so it has a
		 * baseline at once - and then once per MAC_RATE_EVERY seconds, which
		 * is the rate the source itself changes at. */
		let with_macs = ((started - last_macs) >= MAC_RATE_EVERY * 1000);

		if (with_macs)
			last_macs = started;

		try {
			tick(path, max_bytes, with_macs);
		}
		catch (e) {
			/* One bad pass must not take the sampler down. The ring already
			 * carries gap markers, so a missed tick shows up as a break in
			 * the line rather than as a file that stops moving. */
		}

		let wait = step - (mono_ms() - started);

		sleep((wait > MONO_FLOOR) ? wait : MONO_FLOOR);
	}
}

/* ---------------- history ---------------- */

function history_empty() {
	return { version: 1, updated: 0, clients: {} };
}

function history_load(path) {
	let raw = read(path);

	if (!length(raw))
		return history_empty();

	let data = null;

	try {
		data = json(raw);
	}
	catch (e) {
		data = null;
	}

	/* A truncated or foreign file is replaced rather than appended to: the
	 * archive restarts, which is visible in the page, while a broken file would
	 * otherwise be rewritten on every collection. */
	if (data == null || type(data.clients) != 'object')
		return history_empty();

	return data;
}

/* Give up the rows nobody has seen for longest: the retention policy would have
 * taken them next anyway. */
function history_drop(data) {
	let clients = data.clients ?? {};
	let count = 0;

	for (let mac in clients)
		count++;

	if (count == 0)
		return false;

	let ranked = [];

	for (let mac, row in clients)
		push(ranked, [ mac, int(row?.last) ?? 0 ]);

	sort(ranked, (a, b) => a[1] - b[1]);

	let remove = int(count / 8) + 1;

	for (let i = 0; i < remove && i < length(ranked); i++)
		delete clients[ranked[i][0]];

	return true;
}

function history_write(path, data, max_bytes) {
	return write_capped(path, data, max_bytes ?? DEFAULT_MAX_BYTES, history_drop);
}

/*
 * Merge one snapshot into the archive. Records are keyed by MAC, which is the
 * only identifier all three sources share; a host seen only in the neighbour
 * cache is still worth an archive row, because that is what makes "last seen"
 * answerable after it leaves.
 *
 * Online means "reachable right now": ARP resolved it, the IPv6 cache has a
 * link-layer address for it, or the radio lists it as associated. A row that is
 * neither is kept with online=false until retention drops it.
 */
function history_merge(path, snap, retention, max_bytes) {
	let data = history_load(path);
	let now = snap.ts;
	let seen = {};
	let changed = false;
	let written = null;

	function touch(mac, patch) {
		if (!mac)
			return;

		let entry = data.clients[mac];

		if (!entry) {
			entry = { mac: mac, first: now, online: false };
			data.clients[mac] = entry;
		}

		for (let key in patch) {
			let value = patch[key];

			if (value != null && value !== '')
				entry[key] = value;
		}

		entry.last = now;
		seen[mac] = true;
		changed = true;

		return entry;
	}

	for (let neighbour in snap.arp)
		touch(neighbour.mac, {
			ip4: neighbour.ip,
			device: neighbour.device,
			name: neighbour.name,
			online: true
		});

	for (let neighbour in snap.neigh6)
		touch(neighbour.mac, { ip6: neighbour.ip, online: true });

	for (let mac in snap.wifi) {
		let assoc = snap.wifi[mac];

		touch(mac, {
			ssid: assoc.ssid,
			ifname: assoc.ifname,
			band: assoc.band,
			signal: assoc.signal,
			noise: assoc.noise,
			online: true
		});
	}

	/* Anything not seen in this round is offline, not gone. The distinction is
	 * the whole point of keeping the archive. */
	for (let mac in data.clients) {
		let entry = data.clients[mac];

		if (seen[mac]) {
			entry.online = true;
			continue;
		}

		if (entry.online) {
			entry.online = false;
			changed = true;
		}
	}

	/*
	 * A name outlives the station's presence, so it can still label a row that
	 * was recorded before the name was known. This never creates a row: a stale
	 * name must not resurrect a client the retention policy has already dropped.
	 */
	for (let mac in (snap.names ?? {})) {
		let name = snap.names[mac];
		let entry = data.clients[mac];

		if (!entry || entry.name || !name)
			continue;

		entry.name = name;
		changed = true;
	}

	if (retention > 0) {
		let cutoff = now - retention * 86400;
		let stale = [];

		for (let mac in data.clients)
			if ((int(data.clients[mac].last) ?? 0) < cutoff)
				push(stale, mac);

		for (let mac in stale) {
			delete data.clients[mac];
			changed = true;
		}
	}

	if (changed) {
		data.version = 1;
		data.updated = now;

		written = history_write(path, data, max_bytes);

		if (written == null)
			return { ok: false, error: 'cannot write ' + path };
	}

	let rows = 0;

	for (let mac in data.clients)
		rows++;

	return {
		ok: true,
		path: path,
		rows: rows,
		updated: data.updated,
		written: changed,
		bytes: written ? written.bytes : file_bytes(path),
		trimmed: written ? written.trimmed : 0
	};
}

function history_status(path) {
	let data = history_load(path);
	let online = 0, rows = 0;

	for (let mac in data.clients) {
		if (data.clients[mac].online)
			online++;

		rows++;
	}

	return {
		ok: true,
		path: path,
		exists: length(read(path)) > 0,
		rows: rows,
		online: online,
		updated: data.updated
	};
}

/* What the caches actually cost, so the caps can be checked from the outside
 * instead of trusted. */
function file_report(paths, max_bytes) {
	let files = [];
	let total = 0;

	for (let path in paths) {
		let bytes = file_bytes(path);

		total += bytes;
		push(files, { path: path, bytes: bytes, over: (max_bytes > 0 && bytes > max_bytes) });
	}

	return { files: files, total_bytes: total, max_bytes: max_bytes };
}

/* ---------------- main ---------------- */

/*
 * The retention, the cadence and both paths come from the caller rather than
 * from UCI: the collector script owns the schedule and the page only reads the
 * result, so keeping the config in one place avoids two sources of truth for
 * the same file.
 */
if (length(ARGV)) {
	let cmd = ARGV[0];
	let path = ARGV[1] ?? DEFAULT_HISTORY;
	let result;

	if (cmd == 'collect') {
		let retention = number_arg(ARGV[2], 7);
		let every = number_arg(ARGV[3], 30);
		let cache = ARGV[4] ?? DEFAULT_SNAPSHOT;
		let max_bytes = number_arg(ARGV[5], DEFAULT_MAX_BYTES);
		let snap = snapshot(false);
		let prev = cache_load(cache);

		/* PTR resolution stays with the viewer: an AP must not ask the network
		 * for names on a timer, and a routed box only pays for it while
		 * somebody is looking. */
		traffic_derive(snap, prev);
		bridge_derive(snap, prev);
		intra_derive(snap, prev);
		trend_append(snap, prev);

		/* The archive is merged on its own, slower clock and rides on the
		 * snapshot already in hand - walking conntrack is what costs, so the
		 * two cadences share one walk instead of each paying for their own. */
		let hist_ts = int(prev?.hist_ts) ?? 0;
		let due = (prev == null) || (snap.ts - hist_ts >= every) || (snap.ts < hist_ts);

		snap.hist_ts = due ? snap.ts : hist_ts;

		/* The archive is merged before the live file is trimmed: what the page
		 * can afford to forget under a byte ceiling is a different question
		 * from what the history should record, and the trimmer mutates the
		 * snapshot in place. */
		let hist = due ? history_merge(path, snap, retention, max_bytes) : null;
		let live = snapshot_write(cache, snap, max_bytes);

		result = {
			ok: (live != null) && (hist == null || hist.ok != false),
			snapshot: live,
			history: hist
		};
	}
	else if (cmd == 'read')
		result = history_load(path);
	else if (cmd == 'nlbw') {
		let available = nlbw_available();
		let period = (ARGV[1] != null && length(ARGV[1])) ? ARGV[1] : null;
		let usage = available ? nlbw_usage(period) : null;

		result = {
			/* Not an error: the query succeeded, the answer is "this box does not
			 * have nlbwmon". Exiting non-zero here would make the page treat a
			 * missing optional package as a broken probe. */
			ok: true,
			available: available,
			period: period,
			periods: available ? nlbw_periods() : [],
			hosts: usage ?? {}
		};
	}
	else if (cmd == 'clear')
		result = history_write(path, history_empty(), DEFAULT_MAX_BYTES)
			? { ok: true, cleared: true }
			: { ok: false, error: 'cannot write ' + path };
	else if (cmd == 'status') {
		let cache = ARGV[2] ?? DEFAULT_SNAPSHOT;
		let max_bytes = number_arg(ARGV[3], DEFAULT_MAX_BYTES);

		result = history_status(path);
		result.cache = file_report([ path, cache, DEFAULT_SAMPLES, SNOOP_FILE, PTR_CACHE ], max_bytes);

		/* Reported from the snapshot instead of asking nft again: the figure
		 * the page shows is the one in that file, and status is meant to be a
		 * cheap read of what the collector has already done. */
		let cached = cache_load(cache);
		result.intra = cached?.intra ?? { ok: false };
	}
	else if (cmd == 'intra-setup')
		result = intra_setup();
	else if (cmd == 'intra')
		result = intra_read();
	else if (cmd == 'tick')
		result = tick((ARGV[1] != null && length(ARGV[1])) ? ARGV[1] : DEFAULT_SAMPLES,
			number_arg(ARGV[2], DEFAULT_MAX_BYTES));
	else if (cmd == 'loop')
		result = loop((ARGV[1] != null && length(ARGV[1])) ? ARGV[1] : DEFAULT_SAMPLES,
			number_arg(ARGV[2], DEFAULT_MAX_BYTES),
			number_arg(ARGV[3], 1000));
	else
		result = { ok: false, error: 'usage: clients-probe [collect|read|clear|status|nlbw|intra|intra-setup|tick|loop] [path|period] [retention_days] [every|interval_ms] [snapshot] [max_bytes]' };

	print(sprintf('%J\n', result));
	exit((result.ok == false) ? 1 : 0);
}

print(sprintf('%J\n', snapshot(true)));
