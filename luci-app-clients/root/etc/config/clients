config clients 'global'
	option enabled '1'
	# Seconds between two samples. 30 keeps the archive cheap (one conntrack
	# walk plus one assoclist per radio) while still resolving "last seen" to
	# half a minute.
	option interval '30'
	# Days an offline client is kept before the next write drops it. 0 keeps
	# everything until cleared.
	option retention '7'
	# /tmp on purpose: a status page must not wear the flash. Point this at
	# persistent storage deliberately if the history has to survive a reboot.
	option history_path '/tmp/clients-history.json'
	# How often the live snapshot behind the Clients page is refreshed. The
	# collector samples on this clock whether or not anyone is looking, which
	# is what lets the page read a file instead of walking conntrack per
	# viewer; the rates it shows are averages over this window. Raising it
	# costs freshness, not correctness.
	option live_interval '10'
	# The snapshot the page reads, also in /tmp for the same reason.
	option snapshot_path '/tmp/clients-snapshot.json'
	# How often the overview tiles are measured, on their own clock and in
	# their own process. The sampler reads the port counters straight from
	# sysfs - no conntrack, no nlbwmon, no shell - and costs about 8 ms a
	# pass, so one second is affordable and is what the tiles are set to.
	# Raise it to 2 or 5 on a box that should not be touched at all; 0
	# switches the loop off and the tiles fall back to the snapshot's own
	# cadence.
	option tick_interval '1'
	# The ring the page reads for the tiles and the fine-grained part of the
	# chart, in /tmp like the rest.
	option samples_path '/tmp/clients-samples.json'
	# Ceiling in bytes for each cache file this app keeps in /tmp (history,
	# snapshot, snoop table, PTR cache). A file that grows past
	# it drops its least useful rows before being written, so the worst case
	# is a constant rather than a function of how busy the network was. 256 KB
	# is several times what a /24 of real clients needs. Zero or an unreadable
	# value falls back to the built-in 262144 - there is no way to switch the
	# cap off from here.
	option max_bytes '262144'

config clients 'snoop'
	# Passive listening on the LAN bridge: DHCPACK assignments and IPv6
	# neighbour discovery are recorded to /tmp/clients-snoop.json, which is
	# what gives the page IPv6 addresses and DHCP colouring when this device
	# only bridges (AP mode) and owns no leases of its own. Requires the
	# tcpdump binary; without it the daemon stays off and the page degrades.
	# Off it if this device serves DHCP itself and you want zero overhead.
	option enabled '1'
